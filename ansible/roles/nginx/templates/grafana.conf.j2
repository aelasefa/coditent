{% set render_tls_enabled = grafana_render_tls_enabled | default(nginx_tls_enabled | default(false)) %}
{% if render_tls_enabled %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ grafana_server_name | default('grafana.coditent.app') }};

    location ^~ /.well-known/acme-challenge/ {
        root {{ letsencrypt_webroot }};
        default_type "text/plain";
        try_files $uri =404;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ grafana_server_name | default('grafana.coditent.app') }};

    ssl_certificate {{ grafana_tls_certificate_path }};
    ssl_certificate_key {{ grafana_tls_certificate_key_path }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:grafana_tls:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
{% else %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ grafana_server_name | default('grafana.coditent.app') }};
{% endif %}

    client_max_body_size 10M;

    # Keep the challenge path available in the temporary HTTP-only bootstrap
    # configuration used before the first certificate is issued.
    location ^~ /.well-known/acme-challenge/ {
        root {{ letsencrypt_webroot }};
        default_type "text/plain";
        try_files $uri =404;
    }

    # Grafana Live WebSocket support
    location /api/live/ {
        proxy_pass http://{{ grafana_upstream | default('127.0.0.1:3000') }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://{{ grafana_upstream | default('127.0.0.1:3000') }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
