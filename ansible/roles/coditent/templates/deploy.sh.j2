#!/usr/bin/env bash
# ============================================================
# Standalone local deployment helper script on the server
# Generated by Ansible
# ============================================================
set -euo pipefail

APP_DIR="{{ app_dir }}"
cd "$APP_DIR"

echo "=== Pulling latest changes from Git ==="
git fetch origin {{ repo_branch }}
git checkout {{ repo_branch }}
git pull origin {{ repo_branch }}

echo "=== Building and restarting Docker containers ==="
docker compose up -d --build --remove-orphans

echo "=== Waiting for application readiness ==="
readiness_verified=false
for i in {1..15}; do
    if curl --silent --show-error --fail --max-time 5 http://127.0.0.1:{{ api_port }}/ready > /dev/null; then
        echo "Application is ready!"
        readiness_verified=true
        break
    fi
    echo "Waiting for dependencies... ($i/15)"
    sleep 3
done

if [ "$readiness_verified" != "true" ]; then
    echo "ERROR: application did not become ready after 15 attempts" >&2
    exit 1
fi

echo "=== Pruning unused Docker images ==="
docker image prune -f

echo "=== Deployment finished successfully at $(date) ==="
