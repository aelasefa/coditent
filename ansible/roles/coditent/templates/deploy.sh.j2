#!/usr/bin/env bash
# ============================================================
# Standalone local deployment helper script on the server
# Generated by Ansible
# ============================================================
set -euo pipefail

APP_DIR="{{ app_dir }}"
EXPECTED_COMMIT="${1:-}"

if [[ ! "$EXPECTED_COMMIT" =~ ^[0-9a-f]{40}$ ]]; then
    echo "ERROR: deployment requires the tested 40-character commit SHA" >&2
    exit 2
fi

cd "$APP_DIR"

echo "=== Fetching and verifying tested commit ==="
git fetch --prune origin {{ repo_branch }}
git cat-file -e "${EXPECTED_COMMIT}^{commit}"
git merge-base --is-ancestor "$EXPECTED_COMMIT" "origin/{{ repo_branch }}"
git checkout --detach "$EXPECTED_COMMIT"

DEPLOYED_COMMIT="$(git rev-parse HEAD)"
if [ "$DEPLOYED_COMMIT" != "$EXPECTED_COMMIT" ]; then
    echo "ERROR: checked-out commit does not match tested commit" >&2
    exit 3
fi

echo "=== Building and restarting Docker containers ==="
docker compose up -d --build --remove-orphans

echo "=== Waiting for application readiness ==="
readiness_verified=false
for i in {1..15}; do
    if curl --silent --show-error --fail --max-time 5 http://127.0.0.1:{{ api_port }}/ready > /dev/null; then
        echo "Application is ready!"
        readiness_verified=true
        break
    fi
    echo "Waiting for dependencies... ($i/15)"
    sleep 3
done

if [ "$readiness_verified" != "true" ]; then
    echo "ERROR: application did not become ready after 15 attempts" >&2
    exit 1
fi

echo "=== Pruning unused Docker images ==="
docker image prune -f

echo "=== Deployment finished successfully for ${DEPLOYED_COMMIT} at $(date) ==="
