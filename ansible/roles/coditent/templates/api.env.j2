# ============================================================
# Coditent API Environment Configuration (Managed by Ansible)
# Generated on {{ ansible_date_time.iso8601 }}
# ============================================================

APP_ENV={{ 'production' if env_name in ['production', 'staging'] else 'development' }}

# --- Required: Supabase PostgreSQL (sole DB) ---
DATABASE_URL={{ database_url }}

# --- Required: App secrets ---
JWT_SECRET={{ jwt_secret }}
TOTP_ENCRYPTION_KEY={{ totp_encryption_key }}
EMAIL_OUTBOX_ENCRYPTION_KEY={{ email_outbox_encryption_key }}
GEMINI_API_KEY={{ gemini_api_key }}

# --- Required: Supabase admin client (backend-only, NEVER expose to frontend) ---
SUPABASE_URL={{ supabase_url }}
SUPABASE_SERVICE_KEY={{ supabase_service_key }}

# --- CORS / redirects ---
FRONTEND_URL={{ frontend_url }}
CORS_ORIGINS={{ cors_origins }}
ACCESS_TOKEN_COOKIE_SECURE={{ 'true' if env_name in ['production', 'staging'] else 'false' }}

# --- Optional ---
REDIS_URL={{ redis_url }}
READINESS_CHECK_TIMEOUT_SECONDS={{ readiness_check_timeout_seconds }}
WORKER_HEARTBEAT_TTL_SECONDS={{ worker_heartbeat_ttl_seconds }}
GOOGLE_CLIENT_ID={{ google_client_id }}
GOOGLE_CLIENT_SECRET={{ google_client_secret }}
GOOGLE_REDIRECT_URI={{ google_redirect_uri }}
LINKEDIN_CLIENT_ID={{ linkedin_client_id }}
LINKEDIN_CLIENT_SECRET={{ linkedin_client_secret }}
LINKEDIN_REDIRECT_URI={{ linkedin_redirect_uri }}
RESEND_API_KEY={{ resend_api_key }}
RESEND_FROM_EMAIL={{ resend_from_email }}
RESEND_FROM_NAME={{ resend_from_name }}
