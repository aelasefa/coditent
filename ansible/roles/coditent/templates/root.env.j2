# ============================================================
# Coditent Environment Configuration (Managed by Ansible)
# Generated on {{ ansible_date_time.iso8601 }}
# ============================================================

# --- Supabase PostgreSQL (sole persistent DB) ---
DATABASE_URL={{ database_url }}

# --- Supabase Auth / Storage (backend admin client) ---
SUPABASE_URL={{ supabase_url }}
SUPABASE_SERVICE_KEY={{ supabase_service_key }}

# --- Frontend public (safe to expose to browser) ---
NEXT_PUBLIC_SUPABASE_URL={{ next_public_supabase_url }}
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY={{ next_public_supabase_publishable_key }}
NEXT_PUBLIC_API_URL={{ next_public_api_url }}

# --- App secrets (backend-only) ---
JWT_SECRET={{ jwt_secret }}
GEMINI_API_KEY={{ gemini_api_key }}
REDIS_URL={{ redis_url }}
FRONTEND_URL={{ frontend_url }}
INVITATION_EXPIRATION_HOURS={{ invitation_expiration_hours }}

# --- Email (Resend) ---
RESEND_API_KEY={{ resend_api_key }}
RESEND_FROM_EMAIL={{ resend_from_email }}
RESEND_FROM_NAME={{ resend_from_name }}

# --- OAuth (optional) ---
GOOGLE_CLIENT_ID={{ google_client_id }}
GOOGLE_CLIENT_SECRET={{ google_client_secret }}
GOOGLE_REDIRECT_URI={{ google_redirect_uri }}
LINKEDIN_CLIENT_ID={{ linkedin_client_id }}
LINKEDIN_CLIENT_SECRET={{ linkedin_client_secret }}
LINKEDIN_REDIRECT_URI={{ linkedin_redirect_uri }}
