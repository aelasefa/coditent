# ==============================================================================
# Shared HashiCorp Vault Settings (Teammate Environment)
# ==============================================================================
# Shared Vault server address reachable via Tailscale/VPN (e.g. http://100.x.y.z:8200)
# Never expose Vault over plain public HTTP.
VAULT_ADDR=

# AppRole credentials for the coditent-app role.
# Request your unique AppRole Secret ID from the Vault administrator.
# Do not share or commit these credentials.
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# ==============================================================================
# Non-Secret Application Infrastructure Config
# ==============================================================================
APP_ENV=development
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
ACCESS_TOKEN_COOKIE_SECURE=false
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/sso/google/callback
LINKEDIN_REDIRECT_URI=http://localhost:8001/auth/sso/linkedin/callback
NEXT_PUBLIC_API_URL=/api-proxy
NEXT_PUBLIC_OAUTH_API_URL=http://localhost:8001
BACKEND_PROXY_URL=http://api:8001

# Public Supabase client settings (browser-safe public keys, not secrets)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY

# Optional sender labels (not credentials)
RESEND_FROM_EMAIL=your@domain.com
RESEND_FROM_NAME=CODITENT
