  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "title": "Target Availability & Application Readiness",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "bg20mlldakagwc"
      },
      "description": "Scrape availability (up == 1) confirms Prometheus can connect to and scrape the target endpoint over HTTP. Scrape availability indicates connectivity and endpoint responsiveness, but does not guarantee internal application health.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": "DOWN"
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 14,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "13.2.4",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bg20mlldakagwc"
          },
          "editorMode": "code",
          "expr": "up",
          "instant": true,
          "legendFormat": "{{job}} ({{instance}})",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Prometheus Scrape Status by Target",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "bg20mlldakagwc"
      },
      "description": "Application dependency readiness probe result (/ready), checking PostgreSQL, Redis, Celery Worker, and AI Dispatcher. Distinguishes application readiness from pure scrape availability.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "DEGRADED (503)"
                },
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "READY (200)"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 10,
        "x": 14,
        "y": 1
      },
      "id": 10,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "13.2.4",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bg20mlldakagwc"
          },
          "editorMode": "code",
          "expr": "(sum(rate(http_requests_total{job=\"coditent-api\",path=\"/ready\",status_code=\"200\"}[2m])) > bool 0) and on() (up{job=\"coditent-api\"} == 1)",
          "instant": true,
          "legendFormat": "Readiness Probe (/ready)",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Application Readiness Probe",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 101,
      "title": "Coditent User-Facing Backend Telemetry",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "bg20mlldakagwc"
      },
      "description": "Per-second rate of user-facing HTTP requests to the FastAPI backend, calculated over a 1-minute lookback window and segmented by HTTP method and status code. Excludes /ready, /metrics, and /health probes.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Req/s",
            "axisPlacement": "auto",
            "fillOpacity": 15,
            "gradientMode": "none",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "13.2.4",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bg20mlldakagwc"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total{job=\"coditent-api\",path!~\"/ready|/metrics|/health\"}[1m])) by (method, status_code)",
          "legendFormat": "{{method}} {{status_code}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "User-Facing Requests per Second",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "bg20mlldakagwc"
      },
      "description": "95th percentile latency of user-facing HTTP requests, calculated from Prometheus histogram buckets over a 5-minute sliding window. Excludes /ready, /metrics, and /health probes.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Duration",
            "axisPlacement": "auto",
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 12,
        "y": 6
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "pluginVersion": "13.2.4",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bg20mlldakagwc"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(http_request_latency_seconds_bucket{job=\"coditent-api\",path!~\"/ready|/metrics|/health\"}[5m])) by (le))",
          "legendFormat": "p95 Latency",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "User-Facing p95 Request Duration",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "bg20mlldakagwc"
      },
      "description": "Percentage of user-facing HTTP requests returning a 5xx server error. When total traffic is 0 and target is UP, cleanly displays 0%. If target is DOWN or missing, displays No Data instead of masking outages.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 20,
        "y": 6
      },
      "id": 3,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "pluginVersion": "13.2.4",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bg20mlldakagwc"
          },
          "editorMode": "code",
          "expr": "(((sum(rate(http_requests_total{job=\"coditent-api\",path!~\"/ready|/metrics|/health\",status_code=~\"5..\"}[5m])) / (sum(rate(http_requests_total{job=\"coditent-api\",path!~\"/ready|/metrics|/health\"}[5m])) > 0)) * 100)) or (0 * (up{job=\"coditent-api\"} == 1))",
          "instant": true,
          "legendFormat": "5xx Error %",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "User-Facing 5xx Error %",
      "type": "gauge"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 102,
      "title": "Ubuntu Host Infrastructure Metrics",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "bg20mlldakagwc"
      },
      "description": "Total host CPU busy percentage calculated by subtracting average idle CPU time from 100%. Measured across all host CPU cores using Node Exporter.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "id": 5,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "pluginVersion": "13.2.4",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bg20mlldakagwc"
          },
          "editorMode": "code",
          "expr": "(1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m]))) * 100",
          "instant": true,
          "legendFormat": "CPU Usage",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Host CPU Usage",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "bg20mlldakagwc"
      },
      "description": "Percentage of host RAM used, calculated as (1 - (MemAvailable / MemTotal)) * 100. Uses MemAvailable rather than MemFree to properly account for kernel buffers and page caches.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 15
      },
      "id": 6,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "pluginVersion": "13.2.4",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bg20mlldakagwc"
          },
          "editorMode": "code",
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "instant": true,
          "legendFormat": "Memory Usage",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Host Memory Usage",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "bg20mlldakagwc"
      },
      "description": "Percentage of disk space used on the Ubuntu host root (/) filesystem, calculated by comparing available bytes against total filesystem capacity.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "id": 7,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "pluginVersion": "13.2.4",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bg20mlldakagwc"
          },
          "editorMode": "code",
          "expr": "100 - ((node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100)",
          "instant": true,
          "legendFormat": "Disk Usage",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Host Root Filesystem Usage",
      "type": "gauge"
    }
  ],
