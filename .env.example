# Copy to .env; use admin credentials personally and member credentials on EC2/teammates.
VAULT_ADDR=http://127.0.0.1:8200
VAULT_PORT=8200
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# Non-secret application configuration
APP_ENV=development
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
ADMIN_ORIGIN=
ACCESS_TOKEN_COOKIE_SECURE=false
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/sso/google/callback
LINKEDIN_REDIRECT_URI=http://localhost:8001/auth/sso/linkedin/callback
NEXT_PUBLIC_API_URL=/api-proxy
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_OAUTH_API_URL=http://localhost:8001
BACKEND_PROXY_URL=http://api:8001

# Public Supabase client settings. These are designed to be exposed to browsers.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY

# These values are secret and belong in Vault's secret/data/ft_transcendence path.
# DATABASE_URL, SUPABASE_URL, SUPABASE_SERVICE_KEY, JWT_SECRET,
# GEMINI_API_KEY, OAuth client secrets, Resend API key, encryption keys,
# and GF_SECURITY_ADMIN_PASSWORD.

# Optional sender labels (not credentials)
RESEND_FROM_EMAIL=your@domain.com
RESEND_FROM_NAME=CODITENT
# Email OTP verification for password registration (minutes, attempts, resend cooldown seconds)
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# A browser that completes 2FA will not be challenged again for this many days.
TRUSTED_DEVICE_EXPIRE_DAYS=30

# Include the public reverse-proxy prefix used by OAuth start/callback.
OAUTH_BROWSER_COOKIE_PATH=/auth/sso

# --- Grafana / Monitoring ---
GF_SERVER_DOMAIN=grafana.coditent.app
GF_SERVER_ROOT_URL=https://grafana.coditent.app/
GF_SERVER_PROTOCOL=http
GF_AUTH_ANONYMOUS_ENABLED=false
GF_USERS_ALLOW_SIGN_UP=false
GF_SECURITY_COOKIE_SECURE=true
# GF_SECURITY_ADMIN_PASSWORD is intentionally not stored here; load it from Vault.
