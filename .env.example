# Vault address reachable from the host for CLI/UI use. Compose overrides this
# inside backend containers with http://vault:8200.
VAULT_ADDR=http://127.0.0.1:8200

# Limited AppRole credentials for application services. Never use a root token.
# Create these once from a Vault administrator session; see docs/security/vault.md.
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# Non-secret application configuration
APP_ENV=development
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
ACCESS_TOKEN_COOKIE_SECURE=false
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/sso/google/callback
LINKEDIN_REDIRECT_URI=http://localhost:8001/auth/sso/linkedin/callback
NEXT_PUBLIC_API_URL=/api-proxy
NEXT_PUBLIC_OAUTH_API_URL=http://localhost:8001
BACKEND_PROXY_URL=http://api:8001

# Public Supabase client settings. These are designed to be exposed to browsers.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY

# These values are secret and belong in Vault's secret/data/coditent path.
# DATABASE_URL, SUPABASE_URL, SUPABASE_SERVICE_KEY, JWT_SECRET,
# GEMINI_API_KEY, OAuth client secrets, Resend API key, and encryption keys.

# Optional sender labels (not credentials)
RESEND_FROM_EMAIL=your@domain.com
RESEND_FROM_NAME=CODITENT
