# ============================================================
# Coditent — Supabase-only Environment (root)
# Copy to .env and fill with real values. Do NOT commit .env.
# ============================================================

# --- Supabase PostgreSQL (sole persistent DB) ---
# Direct connection (5432) — recommended for migrations & local dev:
#   postgresql+asyncpg://postgres.<PROJECT_REF>:<DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
# Pooled connection (6543, PgBouncer) — recommended for production API (transaction mode):
#   postgresql+asyncpg://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Supabase Dashboard -> Settings -> Database -> Connection string (URI). Replace postgresql:// with postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- Supabase Auth / Storage (backend admin client) ---
# Dashboard -> Settings -> API -> Project URL / service_role (sb_secret_...)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_YOUR_SERVICE_ROLE_KEY

# --- Frontend public (safe to expose to browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_API_URL=http://localhost:8001

# --- App secrets (backend-only) ---
JWT_SECRET=change-me-to-a-random-32-char-secret
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
REDIS_URL=redis://redis:6379/0
FRONTEND_URL=http://localhost:3000
# Used to build invitation links: ${FRONTEND_URL}/invite/employee?token=...
INVITATION_EXPIRATION_HOURS=72

# --- Email (Resend) ---
# Required for invitation emails; if unset, invite still creates but email is logged as warning
RESEND_API_KEY=
RESEND_FROM_EMAIL=coditent@yourdomain.com
RESEND_FROM_NAME=CODITENT

# --- OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/sso/google/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8001/auth/sso/linkedin/callback
