# Frontend-safe only — never put DATABASE_URL or service_role here
NEXT_PUBLIC_API_URL=/api-proxy
NEXT_PUBLIC_WS_URL=
ADMIN_ORIGIN=
BACKEND_PROXY_URL=http://api:8001
# Vercel production: BACKEND_PROXY_URL=https://api.coditent.app/api-proxy
# Keep browser and OAuth traffic same-origin through the Next.js proxy.
NEXT_PUBLIC_OAUTH_API_URL=/api-proxy
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
# Gemini is optional on frontend (prefer backend); keep if needed for AI routes
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
