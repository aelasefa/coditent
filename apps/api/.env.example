# ============================================================
# Coditent API — Supabase-only Environment
# Copy to .env and fill. Do NOT commit .env.
# This file is the canonical backend env (also read by docker-compose via env_file).
# ============================================================

# --- Required: Supabase PostgreSQL (sole DB) ---
# Use one of:
#   Direct (5432): postgresql+asyncpg://postgres.<REF>:<PASS>@db.<REF>.supabase.co:5432/postgres
#   Pooled (6543): postgresql+asyncpg://postgres.<REF>:<PASS>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true
# If you paste from Supabase Dashboard (postgresql://), it is auto-upgraded to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- Required: App secrets ---
JWT_SECRET=change-me-to-a-random-32-char-secret
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# --- Required: Supabase admin client (backend-only, NEVER expose to frontend) ---
# Dashboard -> Settings -> API -> service_role key (sb_secret_...), NOT publishable
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_YOUR_SERVICE_ROLE_KEY

# --- CORS / redirects ---
FRONTEND_URL=http://localhost:3000

# --- Optional ---
REDIS_URL=redis://redis:6379/0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/sso/google/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8001/auth/sso/linkedin/callback
RESEND_API_KEY=
RESEND_FROM_EMAIL=
