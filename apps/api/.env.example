# ============================================================
# Coditent API — Environment Configuration
# ============================================================
# Copy this to .env.  Do NOT commit .env with real secrets.
#
# SECRET MANAGEMENT ARCHITECTURE
# ───────────────────────────────
# All sensitive secrets are stored in HashiCorp Vault (KV v2).
# The .env file only needs the Vault bootstrap values below.
#
# On startup the API:
#   1. Reads VAULT_ADDR + VAULT_TOKEN from the environment.
#   2. Fetches all secrets from Vault at:  secret/data/coditent
#   3. Pydantic Settings merges Vault secrets (priority 1) with
#      env vars (priority 2) so Vault always wins for real secrets.
#
# FIRST TIME SETUP
# ────────────────
# 1. Rename this file to .env.secrets and fill in real values.
# 2. Start Vault:   docker-compose up vault
# 3. Push secrets:  python scripts/vault_init_secrets.py --env-file .env.secrets
# 4. Verify:        python scripts/vault_init_secrets.py --env-file .env.secrets --dry-run
# 5. Then your .env only needs VAULT_ADDR and VAULT_TOKEN (see below).
#
# SECRET ROTATION
# ───────────────
# Update the value in .env.secrets and re-run vault_init_secrets.py.
# No container restart is needed — but restart the API to reload settings.
# ============================================================


# ── Vault Bootstrap (REQUIRED — only two things in your real .env) ───────────
# Without these the API falls back to env vars (safe for local dev without Vault).
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=<YOUR_VAULT_TOKEN>


# ── Secrets that go into Vault (put in .env.secrets, NOT in .env) ────────────
# Copy these to .env.secrets, fill real values, then run vault_init_secrets.py.

# Supabase PostgreSQL (sole DB)
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_REF:YOUR_PASS@db.YOUR_REF.supabase.co:5432/postgres

# App signing & encryption secrets (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=<GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES>
# Generate Fernet keys with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=<FERNET_KEY>
EMAIL_OUTBOX_ENCRYPTION_KEY=<FERNET_KEY>

# Supabase admin client (NEVER expose to frontend)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_YOUR_SERVICE_ROLE_KEY

# AI
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Email delivery (optional)
RESEND_API_KEY=


# ── Non-secret config (safe to put in .env directly) ─────────────────────────
APP_ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
REDIS_URL=redis://redis:6380/0
ACCESS_TOKEN_COOKIE_SECURE=false
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/sso/google/callback
LINKEDIN_REDIRECT_URI=http://localhost:8001/auth/sso/linkedin/callback
NEXT_PUBLIC_OAUTH_API_URL=http://localhost:8001
RESEND_FROM_EMAIL=your@domain.com
RESEND_FROM_NAME=CODITENT
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Pool sizing (docker-compose overrides these per service)
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=15
DB_POOL_RECYCLE_SECONDS=300
READINESS_CHECK_TIMEOUT_SECONDS=5
WORKER_HEARTBEAT_TTL_SECONDS=30
AI_USER_DAILY_QUOTA_UNITS=200
# Include the public reverse-proxy prefix used by OAuth start/callback.
OAUTH_BROWSER_COOKIE_PATH=/auth/sso

# OTP settings
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
TRUSTED_DEVICE_EXPIRE_DAYS=30
